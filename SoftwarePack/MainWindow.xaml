<Window x:Class="SoftwarePack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoftwarePack"
        xmlns:pu="clr-namespace:Panuon.UI.Silver;assembly=Panuon.UI.Silver"
        mc:Ignorable="d"
         Title="SofwarePack" Height="660" Width="420" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Background="#F6F6F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="199*"/>
            <RowDefinition Height="533*"/>
            <RowDefinition Height="28*"/>
        </Grid.RowDefinitions>


        <Image Source="/images/bgtop.png" Stretch="Fill" MouseDown="Window_MouseDown"/>
        <local:Close Margin="0,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" Height="36" Width="82" />

        <Label Name="lbl_Ver" Content="" Grid.Row="2" HorizontalAlignment="Center" Foreground="Gray" MouseUp="lbl_Ver_MouseUp"/>
        <!--产品信息填写-->
        <Grid x:Name="step1" Grid.Row="1" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="29*"/>
                <ColumnDefinition Width="76*"/>
            </Grid.ColumnDefinitions>

            <Label Content="软件名称：" HorizontalAlignment="Left" Margin="62,5,0,0" VerticalAlignment="Top" Height="25" Width="70" Grid.ColumnSpan="2"/>
            <StackPanel Orientation="Horizontal" Grid.Column="1" >
                <TextBox HorizontalAlignment="Left" x:Name="txtSoftName" Width="150" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="16,5,0,428"
                     pu:TextBoxHelper.Watermark="请输入软件名称"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                     pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                     pu:TextBoxHelper.CornerRadius="6"
                     pu:TextBoxHelper.IsClearButtonVisible="True">
                </TextBox>
                <TextBox x:Name="softType" Height="30" Width="100" Margin="5,0,0,420" 
                        pu:TextBoxHelper.Watermark="业务服务器"
                        pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                        pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                        pu:TextBoxHelper.CornerRadius="6"
                        pu:TextBoxHelper.IsClearButtonVisible="True"/>
            </StackPanel>

            <Label Content="软件别名：" HorizontalAlignment="Left" Margin="66,45,0,0" VerticalAlignment="Top" Height="25" Width="70" Grid.ColumnSpan="2"/>
            <TextBox HorizontalAlignment="Left" x:Name="txtSoftAlias" Width="174" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="17,45,0,388"
             pu:TextBoxHelper.Watermark="英文名称（简称）"
             pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
             pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
             pu:TextBoxHelper.CornerRadius="6"
             pu:TextBoxHelper.IsClearButtonVisible="True" Grid.Column="1">
            </TextBox>
            <CheckBox x:Name="WriteRegistry" Margin="196,46,26,389" IsChecked="False" Grid.Column="1">写注册表</CheckBox>


            <Label Content="软件版本：" HorizontalAlignment="Left" Margin="62,93,0,0" VerticalAlignment="Top" Height="25" Width="70" Grid.ColumnSpan="2"/>
            <TextBox HorizontalAlignment="Left" x:Name="txtSoftVersion" Width="250" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="16,89,0,344"                     
                     pu:TextBoxHelper.Watermark="1.0.0.0"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                     pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                     pu:TextBoxHelper.CornerRadius="6" Cursor="IBeam" Grid.Column="1">
            </TextBox>

            <Label Content="软件路径：" HorizontalAlignment="Left" Margin="55,170,0,0" VerticalAlignment="Top" Height="25" Width="70" Grid.ColumnSpan="2" RenderTransformOrigin="0.471,1.727"/>
            <TextBox HorizontalAlignment="Left" x:Name="txtSoftPath" Width="210" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="17,165,0,268"
                     pu:TextBoxHelper.Watermark="..\产品名称\Client"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                     pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                     pu:TextBoxHelper.CornerRadius="6"
                     pu:TextBoxHelper.IsClearButtonVisible="True" Grid.Column="1">
            </TextBox>
            <Image x:Name="img_OpenSoftPath" Source="images/btn_path_normal.png" Stretch="Fill" HorizontalAlignment="Left" Height="30" Margin="237,165,0,0" VerticalAlignment="Top" Width="36" MouseUp="img_btnSoftPath_MouseUp" Grid.Column="1"/>

            <Label Content="主执行程序：" HorizontalAlignment="Left" Margin="46,0,0,0" VerticalAlignment="Center" Height="25" Width="79" Grid.ColumnSpan="2" RenderTransformOrigin="0.532,-0.553"/>
            <TextBox HorizontalAlignment="Left" x:Name="txtMainSoftPath" Width="210" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="17,216,0,217"
                     pu:TextBoxHelper.Watermark="..\产品名称\Clien\My.exe"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                     pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                     pu:TextBoxHelper.CornerRadius="6"
                     pu:TextBoxHelper.IsClearButtonVisible="True" Grid.Column="1">
            </TextBox>
            <Image x:Name="img_OpenMainSoftPath" Source="images/btn_path_normal.png" Stretch="Fill" HorizontalAlignment="Left" Height="30" Margin="237,0,0,0" VerticalAlignment="Center" Width="36" MouseUp="img_OpenMainSoftPath_MouseUp" Grid.Column="1" />

            <CheckBox x:Name="winService" Margin="16,132,41,306" IsChecked="False" Grid.Column="1">Windows服务</CheckBox>

            <CheckBox x:Name="IncludDepend" Margin="19,260,55,178" IsChecked="False" Grid.Column="1">是否包含离线Framework安装包</CheckBox>
            <Label Content="Framework版本:" HorizontalAlignment="Left" Margin="27,294,0,0" VerticalAlignment="Top" Height="25" Width="103" Grid.ColumnSpan="2"/>
            <TextBox x:Name="fwVersion" HorizontalAlignment="Left" Width="250" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="19,292,0,141"                     
                     pu:TextBoxHelper.Watermark="4.7.2"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                     pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                     pu:TextBoxHelper.CornerRadius="6" Cursor="IBeam" Grid.Column="1">
            </TextBox>
            <Label Content="Framework文件:" HorizontalAlignment="Left" Margin="27,336,0,0" VerticalAlignment="Top" Height="25" Width="105" Grid.ColumnSpan="2"/>
            <TextBox x:Name="fwFile" HorizontalAlignment="Left" Width="250" Height="30" Foreground="Black" VerticalContentAlignment="Center" Margin="19,333,0,100"                     
                    pu:TextBoxHelper.Watermark="..\ndp472.exe"
                     pu:TextBoxHelper.FocusedBorderBrush="#00FFE2"
                    pu:TextBoxHelper.FocusedShadowColor="#00FFE2"
                    pu:TextBoxHelper.CornerRadius="6" Cursor="IBeam" Grid.Column="1">
            </TextBox>


            <Label Content="图标：" HorizontalAlignment="Left" Margin="90,380,0,0" VerticalAlignment="Top" Height="25" Width="46" Grid.ColumnSpan="2"/>
            <Image x:Name="imgSoftIcon" MouseUp="img_form_MouseUp" Source="/images/logo.ico" HorizontalAlignment="Left" Height="36" Margin="20,374,0,0" VerticalAlignment="Top" Width="36" Grid.Column="1"/>
            <Label Content="卸载图标：" HorizontalAlignment="Left" Margin="66,423,0,0" VerticalAlignment="Top" Height="25" Width="70" Grid.ColumnSpan="2"/>
            <Image x:Name="imgSoftUninstIcon" MouseUp="img_form_MouseUp" Source="images/uninst.ico" HorizontalAlignment="Left" Height="36" Margin="20,417,0,0" VerticalAlignment="Top" Width="36" Grid.Column="1"/>

            <Button x:Name="btnNext" Content="下一步" Foreground="White" FontSize="16" HorizontalAlignment="Left" Margin="179,413,0,0" VerticalAlignment="Top" Width="87" Height="35" Click="btnNext_Click" pu:ButtonHelper.ClickStyle="Sink" FontFamily="{StaticResource FontAwesome}" Background="#C800AAFF" pu:ButtonHelper.HoverBrush="#00AAFF" pu:ButtonHelper.CornerRadius="8" Grid.Column="1"/>

        </Grid>

        <!--界面图片自定义-->
        <Grid x:Name="step2" Visibility="Hidden" Grid.Row="1">
            <!--主图-->
            <Label Content="主图片(1张)：请添加安装程序主界面（尺寸570*247）" HorizontalAlignment="Left" Margin="21,5,0,0" VerticalAlignment="Top" Height="25" Width="355"/>
            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="150,30,150,0" Height="85" Width="120">
                <Image x:Name="img_TopLogo" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85" VerticalAlignment="Top" Width="120" MouseUp="img_form_MouseUp"/>
            </Border>

            <!--轮播图-->
            <Label Content="轮播图片(3张)：请添加安装过程中要展示的图片（尺寸570*345）" HorizontalAlignment="Left" Margin="21,120,0,0" VerticalAlignment="Top" Height="25" Width="368"/>
            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="21,150,279,0" Height="85" Width="120">
                <Image x:Name="img_Carousel_1" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85" VerticalAlignment="Top" Width="120" Margin="-1"/>
            </Border>
            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="150,150,150,0" Height="85" Width="120">
                <Image x:Name="img_Carousel_2" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85" VerticalAlignment="Top" Width="120"/>
            </Border>
            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="282,150,18,0" Height="85" Width="120">
                <Image x:Name="img_Carousel_3" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85" VerticalAlignment="Top" Width="120"/>
            </Border>

            <!--卸载图片-->
            <Label Content="卸载界面图片(3张)：请添加卸载过程中要展示的图片（尺寸570*330）" HorizontalAlignment="Left" Margin="21,240,0,0" VerticalAlignment="Top" Height="25" Width="381"/>
            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="21,270,279,0"  Height="85" Width="120">
                <Image x:Name="img_Uninstall_1" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85" VerticalAlignment="Top" Width="120"/>
            </Border>

            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="150,270,150,0" Height="85" Width="120">
                <Image x:Name="img_Uninstall_2" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85"  VerticalAlignment="Top" Width="120"/>
            </Border>

            <Border BorderThickness="1" BorderBrush="#FF000000" VerticalAlignment="Top" Margin="282,270,18,0" Height="85" Width="120">
                <Image x:Name="img_Uninstall_3" MouseUp="img_form_MouseUp" Source="images/btn_addimg.png" HorizontalAlignment="Left" Stretch="Fill"  Height="85"  VerticalAlignment="Top" Width="120"/>
            </Border>

            <Label Name="lbl_OpenOutput" Content="打开输出文件夹" Cursor="Hand" HorizontalAlignment="Left" Margin="21,421,0,0" VerticalAlignment="Top" Height="25" Width="99" Foreground="Gray" FontStyle="Italic" MouseUp="lbl_OpenOutput_MouseUp"/>

            <Button x:Name="btnLastStep" Content="上一步" Foreground="White" FontSize="16" HorizontalAlignment="Left" Margin="206,420,0,0" VerticalAlignment="Top" Width="87" Height="27" RenderTransformOrigin="0.506,0.481" Click="btnLastStep_Click" pu:ButtonHelper.ClickStyle="Sink" FontFamily="{StaticResource FontAwesome}" Background="#C800AAFF" pu:ButtonHelper.HoverBrush="#00AAFF" pu:ButtonHelper.CornerRadius="8"/>
            <Button x:Name="btnBuild" Content="打包" Foreground="White" FontSize="16" HorizontalAlignment="Left" Margin="313,420,0,0" VerticalAlignment="Top" Width="89" Height="27" Click="btnBuild_Click" RenderTransformOrigin="0.506,0.481" pu:ButtonHelper.ClickStyle="Sink" FontFamily="{StaticResource FontAwesome}" Background="#C800AAFF" pu:ButtonHelper.HoverBrush="#00AAFF" pu:ButtonHelper.CornerRadius="8"/>
        </Grid>
    </Grid>
</Window>
